<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ cloud backup and device-to-device transfer. Same content as backup_rules.xml: the school
   database and the photo files it references. Cache (camera captures, PDFs, exports) is never included.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="photos/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="photos/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
